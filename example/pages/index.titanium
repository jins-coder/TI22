---
// 1. Ensure SQLite Table exists
db_exec("CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, email TEXT NOT NULL UNIQUE, role TEXT DEFAULT 'developer', created_at DATETIME DEFAULT CURRENT_TIMESTAMP);");

// 2. Handle POST Form Submission (Zero-reload Turbo submission)
if req.method == "POST" {
  let action = body.action;
  let id = body.id;
  let name = body.name;
  let email = body.email;
  let role = if body.role != () && body.role != "" { body.role } else { "developer" };

  if action == "delete" && id != () && id != "" {
    db_run("DELETE FROM users WHERE id = ?", [id]);
    session.flash("msg", "🗑️ User deleted from SQLite!");
  } else if name != () && name != "" && email != () && email != "" {
    db_run("INSERT INTO users (name, email, role) VALUES (?, ?, ?)", [name, email, role]);
    session.flash("msg", "✨ New user created in native Titanium engine!");
  }

  return redirect("/");
}

// 3. Query Database
let users = db_query("SELECT * FROM users ORDER BY id DESC");
let count = users.len();
let msg = session.flash("msg");
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Titanium (Ti22) | Native Web Runtime</title>
  <link rel="stylesheet" href="/app.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap">
</head>
<body>
  <div class="container">
    <header class="hero">
      <div class="badge">⚡ TITANIUM (TI22) NATIVE ENGINE</div>
      <h1>Titanium Web Runtime</h1>
      <p class="subtitle">Standalone Native Binary • Friendly Clean Syntax • Embedded SQLite • Turbo SPA</p>
      <div style="margin-top: 15px; display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
        <a href="/spa_demo" class="btn btn-primary" style="font-size: 0.85rem; padding: 6px 14px; text-decoration: none;">⚡ Turbo SPA Demo</a>
        <a href="/__titanium_studio" class="btn" style="font-size: 0.85rem; padding: 6px 14px; text-decoration: none; background: rgba(168, 85, 247, 0.15); border: 1px solid rgba(168, 85, 247, 0.3); color: #c084fc;">🛠️ Web Studio</a>
        <a href="/nextgen" class="btn" style="font-size: 0.85rem; padding: 6px 14px; text-decoration: none; background: rgba(56, 189, 248, 0.15); border: 1px solid rgba(56, 189, 248, 0.3); color: #38bdf8;">🚀 Next-Gen Omniverse</a>
        <a href="/php_features" class="btn" style="font-size: 0.85rem; padding: 6px 14px; text-decoration: none; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);">🐘 PHP 8.1 - 8.5 Primitives</a>
      </div>
    </header>

    {% if msg %}
      <div class="alert alert-success">{{ msg }}</div>
    {% endif %}

    <div class="grid">
      <!-- Create User Card -->
      <div class="card">
        <h2>➕ Add New User</h2>
        <p class="card-desc">Submits to native Rust/C SQLite engine with zero full-page reloads.</p>
        <form method="POST" action="/" class="form">
          <div class="form-group">
            <label>Full Name</label>
            <input type="text" name="name" placeholder="Grace Hopper" required>
          </div>
          <div class="form-group">
            <label>Email Address</label>
            <input type="email" name="email" placeholder="grace@navy.mil" required>
          </div>
          <div class="form-group">
            <label>Role</label>
            <select name="role">
              <option value="systems">Systems Architect</option>
              <option value="security">Security Engineer</option>
              <option value="developer">Core Developer</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary">Create User in SQLite</button>
        </form>
      </div>

      <!-- User List Card -->
      <div class="card">
        <div class="card-header-flex">
          <h2>👥 Native SQLite Users ({{ count }})</h2>
          <a href="/api/users" class="api-link" target="_blank">JSON API ↗</a>
        </div>
        <p class="card-desc">Queried directly from embedded SQLite in microseconds.</p>

        {% if count == 0 %}
          <div class="empty-state">
            <p>No users yet. Add your first user on the left!</p>
          </div>
        {% else %}
          <div class="user-list">
            {% for u in users %}
              <div class="user-item">
                <div class="user-info">
                  <span class="user-name">
                    <a href="/users/{{ u.id }}" class="user-link">{{ u.name }}</a>
                  </span>
                  <span class="user-email">{{ u.email }}</span>
                </div>
                <div class="user-meta">
                  <span class="role-tag">{{ u.role }}</span>
                  <form method="POST" action="/" style="display:inline;">
                    <input type="hidden" name="action" value="delete">
                    <input type="hidden" name="id" value="{{ u.id }}">
                    <button type="submit" class="btn-delete" title="Delete User">✕</button>
                  </form>
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>

    <footer class="footer">
      <p>Powered by <strong>Titanium (Ti22)</strong> • Native Standalone Rust & SQLite Web Runtime</p>
    </footer>
  </div>
</body>
</html>
