---
// 1. Handle POST Actions (Create Product, Delete, Update Stock)
if req.method == "POST" {
  let action = body.action;

  if action == "create" {
    let name = body.name;
    let category = body.category;
    let price = parse_float(body.price);
    let compare_price = if body.compare_at_price != () && body.compare_at_price != "" { parse_float(body.compare_at_price) } else { 0.0 };
    let stock = if body.stock != () && body.stock != "" { parse_int(body.stock) } else { 10 };
    let badge = if body.badge != () { body.badge } else { "" };
    let image_url = if body.image_url != () && body.image_url != "" { body.image_url } else { "https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=800&q=80" };
    let description = if body.description != () && body.description != "" { body.description } else { "Precision engineered titanium hardware item." };
    let is_featured = if body.is_featured == "1" { 1 } else { 0 };

    // Generate unique slug
    let slug = name.to_lower().replace(" ", "-") + "-" + to_string(parse_int(to_string(stock)) * 7 + 101);

    db_run("INSERT INTO products (name, slug, category, price, compare_at_price, stock, rating, reviews_count, image_url, badge, description, is_featured) VALUES (?, ?, ?, ?, ?, ?, 5.0, 1, ?, ?, ?, ?)",
      [name, slug, category, price, compare_price, stock, image_url, badge, description, is_featured]);

    session.flash("msg", "✨ New product '" + name + "' added to vault catalog!");
    return redirect("/admin/products");
  } else if action == "delete" {
    let pid = body.product_id;
    db_run("DELETE FROM products WHERE id = ?", [pid]);
    session.flash("msg", "🗑️ Product #" + to_string(pid) + " removed from catalog.");
    return redirect("/admin/products");
  } else if action == "update_stock" {
    let pid = body.product_id;
    let new_stock = parse_int(body.stock);
    db_run("UPDATE products SET stock = ? WHERE id = ?", [new_stock, pid]);
    session.flash("msg", "📦 Stock updated for product #" + to_string(pid));
    return redirect("/admin/products");
  }
}

// 2. Fetch All Products
let products = db_query("SELECT * FROM products ORDER BY id DESC");
let flash_msg = session.flash("msg");
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Product Inventory Manager | TITANSTORE Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/app.css">
</head>
<body class="bg-[#090d16] text-slate-100 min-h-screen flex flex-col antialiased selection:bg-sky-500 selection:text-white">

  <!-- Admin Top Navigation -->
  <header class="sticky top-0 z-50 glass-header border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 gap-4">
        
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-sky-400 to-indigo-500 flex items-center justify-center text-slate-950 font-black text-lg shadow-lg shadow-sky-500/20">
            Ti
          </div>
          <div>
            <span class="text-base font-black tracking-wider text-white">TITAN<span class="text-sky-400">ADMIN</span></span>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <a href="/admin" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800/80 transition">
            Dashboard
          </a>
          <a href="/admin/products" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-sky-500 text-slate-950 shadow-md shadow-sky-500/20">
            Products
          </a>
          <a href="/admin/orders" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800/80 transition">
            Orders
          </a>
          <a href="/" class="ml-2 px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white border border-white/10 transition">
            Storefront ↗
          </a>
        </div>

      </div>
    </div>
  </header>

  <!-- Flash Message -->
  {% if flash_msg %}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4 w-full">
      <div class="bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 px-4 py-3 rounded-xl text-sm font-medium">
        {{ flash_msg }}
      </div>
    </div>
  {% endif %}

  <!-- Products Main Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 w-full space-y-8">
    
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Product Inventory Management</h1>
        <p class="text-xs text-slate-400 mt-1">Manage catalog items, pricing, and stock levels in real-time</p>
      </div>
    </div>

    <!-- 2 Column Layout: Product Creator Form + Inventory Table -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Add Product Card -->
      <div class="lg:col-span-4 glass-panel p-6 rounded-2xl space-y-4 glow-cyan">
        <h2 class="text-base font-bold text-white pb-3 border-b border-white/10 flex items-center gap-2">
          <span>➕</span>
          Add New Product
        </h2>

        <form method="POST" action="/admin/products" class="space-y-3.5 text-xs">
          <input type="hidden" name="action" value="create">

          <div class="space-y-1">
            <label class="font-semibold text-slate-300">Product Name</label>
            <input type="text" name="name" placeholder="Titanium Wireless Mouse" required class="w-full bg-slate-900 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-sky-400">
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="space-y-1">
              <label class="font-semibold text-slate-300">Category</label>
              <select name="category" class="w-full bg-slate-900 border border-white/10 rounded-lg px-2.5 py-2 text-white focus:outline-none focus:border-sky-400">
                <option value="Peripherals">Peripherals</option>
                <option value="Wearables">Wearables</option>
                <option value="Hardware">Hardware</option>
                <option value="Audio">Audio</option>
                <option value="Gear">Gear</option>
              </select>
            </div>
            <div class="space-y-1">
              <label class="font-semibold text-slate-300">Badge</label>
              <input type="text" name="badge" placeholder="e.g. New" class="w-full bg-slate-900 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-sky-400">
            </div>
          </div>

          <div class="grid grid-cols-3 gap-3">
            <div class="space-y-1">
              <label class="font-semibold text-slate-300">Price ($)</label>
              <input type="number" step="0.01" name="price" placeholder="199.00" required class="w-full bg-slate-900 border border-white/10 rounded-lg px-2 py-2 text-white font-mono focus:outline-none focus:border-sky-400">
            </div>
            <div class="space-y-1">
              <label class="font-semibold text-slate-300">Compare ($)</label>
              <input type="number" step="0.01" name="compare_at_price" placeholder="240.00" class="w-full bg-slate-900 border border-white/10 rounded-lg px-2 py-2 text-white font-mono focus:outline-none focus:border-sky-400">
            </div>
            <div class="space-y-1">
              <label class="font-semibold text-slate-300">Stock</label>
              <input type="number" name="stock" value="15" required class="w-full bg-slate-900 border border-white/10 rounded-lg px-2 py-2 text-white font-mono focus:outline-none focus:border-sky-400">
            </div>
          </div>

          <div class="space-y-1">
            <label class="font-semibold text-slate-300">Image URL</label>
            <input type="url" name="image_url" placeholder="https://images.unsplash.com/..." class="w-full bg-slate-900 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-sky-400">
          </div>

          <div class="space-y-1">
            <label class="font-semibold text-slate-300">Description</label>
            <textarea name="description" rows="3" placeholder="Crafted with pure titanium..." class="w-full bg-slate-900 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-sky-400"></textarea>
          </div>

          <div class="flex items-center gap-2 pt-1">
            <input type="checkbox" name="is_featured" value="1" id="feat" class="accent-sky-400">
            <label for="feat" class="text-slate-300 font-semibold cursor-pointer">Feature on Homepage Banner</label>
          </div>

          <button type="submit" class="w-full py-3 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold text-xs shadow-lg shadow-sky-500/25 transition cursor-pointer">
            Create Product in SQLite
          </button>
        </form>
      </div>

      <!-- Right Column: Products Table -->
      <div class="lg:col-span-8 glass-panel p-6 rounded-2xl space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-white/10">
          <h2 class="text-base font-bold text-white">All Products ({{ products.len() }})</h2>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="text-slate-400 border-b border-white/5">
                <th class="pb-3 font-semibold">Product</th>
                <th class="pb-3 font-semibold">Category</th>
                <th class="pb-3 font-semibold">Price</th>
                <th class="pb-3 font-semibold">Stock</th>
                <th class="pb-3 font-semibold text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              {% for p in products %}
                <tr class="hover:bg-white/5 transition">
                  <td class="py-3.5 flex items-center gap-3">
                    <img src="{{ p.image_url }}" alt="{{ p.name }}" class="w-10 h-10 rounded-lg object-cover bg-slate-950 shrink-0">
                    <div>
                      <div class="font-bold text-white hover:text-sky-400">
                        <a href="/product/{{ p.id }}">{{ p.name }}</a>
                      </div>
                      {% if p.badge != "" %}
                        <span class="text-[9px] font-bold text-sky-400 uppercase">{{ p.badge }}</span>
                      {% endif %}
                    </div>
                  </td>

                  <td class="py-3.5">
                    <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-900 border border-white/10 text-slate-300">
                      {{ p.category }}
                    </span>
                  </td>

                  <td class="py-3.5 font-mono font-bold text-white">${{ p.price }}</td>

                  <td class="py-3.5">
                    <!-- Instant stock update form -->
                    <form method="POST" action="/admin/products" class="flex items-center gap-1.5 m-0">
                      <input type="hidden" name="action" value="update_stock">
                      <input type="hidden" name="product_id" value="{{ p.id }}">
                      <input type="number" name="stock" value="{{ p.stock }}" onchange="this.form.requestSubmit()" class="w-16 bg-slate-900 border border-white/10 rounded px-1.5 py-0.5 font-mono text-center text-white text-xs">
                    </form>
                  </td>

                  <td class="py-3.5 text-right">
                    <form method="POST" action="/admin/products" class="inline-block m-0" onsubmit="return confirm('Delete this product from catalog?');">
                      <input type="hidden" name="action" value="delete">
                      <input type="hidden" name="product_id" value="{{ p.id }}">
                      <button type="submit" class="p-1.5 text-rose-400 hover:text-rose-300 rounded hover:bg-rose-500/10 transition" title="Delete Product">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                      </button>
                    </form>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>

    </div>

  </main>

</body>
</html>
