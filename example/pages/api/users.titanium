// Ensure SQLite table exists
db_exec("CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, email TEXT NOT NULL UNIQUE, role TEXT DEFAULT 'developer', created_at DATETIME DEFAULT CURRENT_TIMESTAMP);");

if req.method == "POST" {
  if body.name != "" && body.email != "" {
    let result = db_run("INSERT INTO users (name, email, role) VALUES (?, ?, ?)", [body.name, body.email, body.role]);
    return json(#{
      success: true,
      inserted_id: result.last_insert_id,
      message: "User created via Titanium native API"
    }, 201);
  } else {
    return json(#{
      success: false,
      error: "Missing name or email in body"
    }, 400);
  }
}

// GET /api/users
let users = db_query("SELECT * FROM users ORDER BY id DESC");
return json(#{
  success: true,
  engine: "Titanium (Ti22) Native",
  count: users.len(),
  data: users
});
