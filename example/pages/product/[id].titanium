---
// 1. Fetch Product by ID
let product_id = params.id;
let product = db_first("SELECT * FROM products WHERE id = ?", [product_id]);
let exists = product != ();

// 2. Fetch related products in the same category
let related = [];
if exists {
  related = db_query("SELECT * FROM products WHERE category = ? AND id != ? LIMIT 3", [product.category, product_id]);
}

// 3. Cart items count
let sid = session.id();
let cart_count_res = db_first("SELECT SUM(quantity) as total_items FROM cart_items WHERE session_id = ?", [sid]);
let cart_count = if cart_count_res != () && cart_count_res.total_items != () { cart_count_res.total_items } else { 0 };

let flash_msg = session.flash("msg");
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if exists %}{{ product.name }} | TITANSTORE{% else %}Product Not Found | TITANSTORE{% endif %}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/app.css">
</head>
<body class="bg-[#090d16] text-slate-100 min-h-screen flex flex-col antialiased selection:bg-sky-500 selection:text-white">

  <!-- Navigation Bar -->
  <header class="sticky top-0 z-50 glass-header">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 gap-4">
        
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-sky-400 to-indigo-500 flex items-center justify-center text-slate-950 font-black text-lg shadow-lg shadow-sky-500/20 group-hover:scale-105 transition">
            Ti
          </div>
          <div>
            <span class="text-lg font-black tracking-wider text-white">TITAN<span class="text-sky-400">STORE</span></span>
          </div>
        </a>

        <div class="flex items-center gap-3">
          <a href="/" class="text-xs font-semibold text-slate-300 hover:text-white px-3 py-1.5 rounded-lg bg-slate-800/60 border border-white/10 transition">
            ← Back to Store
          </a>

          <a href="/cart" class="relative flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-sky-500 to-indigo-600 text-white text-sm font-bold shadow-lg shadow-sky-500/25 transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
            <span>Cart</span>
            {% if cart_count > 0 %}
              <span class="bg-white text-slate-950 text-xs font-black px-1.5 py-0.5 rounded-full font-mono">{{ cart_count }}</span>
            {% endif %}
          </a>
        </div>

      </div>
    </div>
  </header>

  <!-- Flash Notification Toast -->
  {% if flash_msg %}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4 w-full">
      <div class="bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 px-4 py-3 rounded-xl flex items-center justify-between gap-3 text-sm font-medium">
        <span>✨ {{ flash_msg }}</span>
        <a href="/cart" class="text-xs font-bold text-emerald-400 underline hover:text-emerald-200">View Cart →</a>
      </div>
    </div>
  {% endif %}

  <!-- Product Details Section -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-1 w-full">
    
    {% if exists %}
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-slate-400 mb-8 font-medium">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>/</span>
        <a href="/?category={{ product.category }}" class="hover:text-white transition">{{ product.category }}</a>
        <span>/</span>
        <span class="text-sky-400 font-bold truncate max-w-[200px]">{{ product.name }}</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        
        <!-- Product High-Res Image Preview -->
        <div class="lg:col-span-7">
          <div class="glass-panel overflow-hidden p-2 rounded-2xl glow-cyan">
            <img src="{{ product.image_url }}" alt="{{ product.name }}" class="w-full h-80 sm:h-[450px] object-cover rounded-xl shadow-2xl">
          </div>
        </div>

        <!-- Product Specs & Purchase Form -->
        <div class="lg:col-span-5 space-y-6">
          
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="px-2.5 py-1 rounded-md text-[10px] font-bold bg-sky-500/20 text-sky-400 border border-sky-500/30 uppercase tracking-wider">
                {{ product.category }}
              </span>
              {% if product.badge != "" %}
                <span class="px-2.5 py-1 rounded-md text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30 uppercase tracking-wider">
                  {{ product.badge }}
                </span>
              {% endif %}
            </div>

            <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight leading-snug">
              {{ product.name }}
            </h1>

            <div class="flex items-center gap-3 mt-3">
              <div class="flex items-center text-amber-400 text-sm font-bold">
                <span>★ {{ product.rating }}</span>
                <span class="text-slate-500 font-normal ml-1.5">({{ product.reviews_count }} verified reviews)</span>
              </div>
              <span class="text-slate-600">•</span>
              <span class="text-xs font-semibold text-emerald-400 flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                In Stock ({{ product.stock }} units)
              </span>
            </div>
          </div>

          <!-- Price -->
          <div class="p-4 rounded-xl bg-slate-900/60 border border-white/5 flex items-baseline gap-3">
            <span class="text-3xl font-black text-white font-mono">${{ product.price }}</span>
            {% if product.compare_at_price > product.price %}
              <span class="text-base text-slate-500 line-through font-mono">${{ product.compare_at_price }}</span>
              <span class="text-xs font-bold text-rose-400 bg-rose-500/10 px-2 py-0.5 rounded">Save ${{ product.compare_at_price - product.price }}</span>
            {% endif %}
          </div>

          <!-- Description -->
          <div class="text-sm text-slate-300 leading-relaxed space-y-2">
            <p>{{ product.description }}</p>
          </div>

          <!-- Add to Cart Form -->
          <form method="POST" action="/cart" class="space-y-4 pt-2">
            <input type="hidden" name="action" value="add">
            <input type="hidden" name="product_id" value="{{ product.id }}">

            <div class="flex items-center gap-4">
              <label class="text-xs font-bold text-slate-300">Quantity:</label>
              <select name="quantity" class="bg-slate-900 border border-white/10 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-sky-400">
                <option value="1">1 unit</option>
                <option value="2">2 units</option>
                <option value="3">3 units</option>
                <option value="5">5 units (Bulk)</option>
              </select>
            </div>

            <button type="submit" class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-sky-500 to-indigo-600 hover:from-sky-400 hover:to-indigo-500 text-white font-bold text-sm shadow-xl shadow-sky-500/25 hover:shadow-sky-500/40 transition flex items-center justify-center gap-2 cursor-pointer">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
              <span>Add to Cart — ${{ product.price }}</span>
            </button>
          </form>

          <!-- Specifications Table -->
          <div class="pt-6 border-t border-white/5 space-y-2.5 text-xs">
            <div class="flex justify-between py-1.5 border-b border-white/5">
              <span class="text-slate-400">Material</span>
              <span class="font-semibold text-white">Aerospace Grade 5 Titanium (Ti-6Al-4V)</span>
            </div>
            <div class="flex justify-between py-1.5 border-b border-white/5">
              <span class="text-slate-400">Finish</span>
              <span class="font-semibold text-white">Bead-Blasted Ceramic Anti-Scratch</span>
            </div>
            <div class="flex justify-between py-1.5 border-b border-white/5">
              <span class="text-slate-400">Warranty</span>
              <span class="font-semibold text-emerald-400">Lifetime Titanium Guarantee</span>
            </div>
            <div class="flex justify-between py-1.5">
              <span class="text-slate-400">Fulfillment</span>
              <span class="font-semibold text-sky-400">Dispatched in 24 Hours</span>
            </div>
          </div>

        </div>

      </div>

      <!-- Related Products Grid -->
      {% if related | length > 0 %}
        <section class="mt-16 pt-12 border-t border-white/5">
          <h3 class="text-xl font-bold text-white mb-6">Related Titanium Equipment</h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            {% for r in related %}
              <div class="glass-card p-4 rounded-xl flex flex-col justify-between">
                <div>
                  <a href="/product/{{ r.id }}" class="block aspect-video overflow-hidden rounded-lg mb-3">
                    <img src="{{ r.image_url }}" alt="{{ r.name }}" class="w-full h-full object-cover hover:scale-105 transition">
                  </a>
                  <h4 class="font-bold text-sm text-white hover:text-sky-400">
                    <a href="/product/{{ r.id }}">{{ r.name }}</a>
                  </h4>
                </div>
                <div class="mt-4 flex items-center justify-between">
                  <span class="font-mono font-bold text-sm text-white">${{ r.price }}</span>
                  <a href="/product/{{ r.id }}" class="text-xs font-semibold text-sky-400 hover:text-sky-300">View Specs →</a>
                </div>
              </div>
            {% endfor %}
          </div>
        </section>
      {% endif %}

    {% else %}
      <div class="text-center py-24 glass-panel max-w-lg mx-auto p-8 rounded-2xl">
        <h2 class="text-2xl font-bold text-rose-400 mb-2">Product Not Found</h2>
        <p class="text-xs text-slate-400 mb-6">The requested product ID #{{ product_id }} is not in the database.</p>
        <a href="/" class="px-5 py-2.5 bg-sky-500 text-slate-950 font-bold rounded-xl text-xs">Return to Catalog</a>
      </div>
    {% endif %}

  </main>

  <footer class="border-t border-white/5 bg-slate-950/80 mt-16 py-8 text-center text-xs text-slate-500">
    © 2026 Titanium (Ti22) Native Web Runtime • Single-File SSR Component
  </footer>

</body>
</html>
