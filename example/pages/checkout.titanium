---
// 1. Session & Cart Check
let sid = session.id();
let cart_items = db_query("SELECT c.id as cart_id, c.quantity, p.id as product_id, p.name, p.price, p.image_url, (c.quantity * p.price) as line_total FROM cart_items c JOIN products p ON c.product_id = p.id WHERE c.session_id = ?", [sid]);

if cart_items.len() == 0 && req.method == "GET" {
  return redirect("/cart");
}

let subtotal = 0.0;
for item in cart_items {
  subtotal += item.line_total;
}

let discount_percent = session.get("discount_percent");
let discount_rate = if discount_percent != () { discount_percent } else { 0.0 };
let discount_amount = subtotal * discount_rate;
let shipping_cost = if subtotal > 150.0 || subtotal == 0.0 { 0.0 } else { 15.0 };
let total = (subtotal - discount_amount) + shipping_cost;

// 2. Handle POST Order Placement
if req.method == "POST" {
  let name = body.name;
  let email = body.email;
  let address = body.address;
  let city = body.city;
  let payment_method = if body.payment_method != () && body.payment_method != "" { body.payment_method } else { "Credit Card" };

  if name != () && name != "" && email != () && email != "" && address != () && address != "" {
    // Generate order number
    let order_num = "TI-" + to_string(10000 + (parse_int(to_string(cart_items.len())) * 137) + 5421);

    db_run("INSERT INTO orders (order_number, customer_name, customer_email, customer_address, customer_city, subtotal, discount, shipping, total, status, payment_method) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 'Processing', ?)", 
      [order_num, name, email, address, city, subtotal, discount_amount, shipping_cost, total, payment_method]);

    let created_order = db_first("SELECT id FROM orders WHERE order_number = ?", [order_num]);
    let order_id = if created_order != () { created_order.id } else { 1 };

    // Transfer cart items to order items
    for item in cart_items {
      db_run("INSERT INTO order_items (order_id, product_id, product_name, price, quantity, image_url) VALUES (?, ?, ?, ?, ?, ?)",
        [order_id, item.product_id, item.name, item.price, item.quantity, item.image_url]);
    }

    // Empty Cart
    db_run("DELETE FROM cart_items WHERE session_id = ?", [sid]);
    session.remove("coupon_code");
    session.remove("discount_percent");

    return redirect("/order_success/" + to_string(order_id));
  } else {
    session.flash("err", "Please fill in all shipping fields.");
    return redirect("/checkout");
  }
}

let flash_err = session.flash("err");
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Express Checkout | TITANSTORE</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/app.css">
</head>
<body class="bg-[#090d16] text-slate-100 min-h-screen flex flex-col antialiased selection:bg-sky-500 selection:text-white">

  <!-- Minimal Header -->
  <header class="border-b border-white/5 py-4 bg-slate-950/80 backdrop-blur">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-sky-500 flex items-center justify-center text-slate-950 font-black text-sm">Ti</div>
        <span class="font-black text-white tracking-wider">TITAN<span class="text-sky-400">STORE</span></span>
      </a>
      <div class="flex items-center gap-2 text-xs text-slate-400 font-semibold">
        <span>🔒 256-Bit SSL Encrypted Checkout</span>
      </div>
    </div>
  </header>

  <!-- Flash Error -->
  {% if flash_err %}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4 w-full">
      <div class="bg-rose-500/10 border border-rose-500/30 text-rose-300 px-4 py-3 rounded-xl text-sm font-medium">
        {{ flash_err }}
      </div>
    </div>
  {% endif %}

  <!-- Checkout Section -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-1 w-full">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Shipping & Payment Form -->
      <div class="lg:col-span-7 space-y-6">
        <form method="POST" action="/checkout" class="space-y-6">
          
          <!-- Step 1: Customer Contact -->
          <div class="glass-panel p-6 rounded-2xl space-y-4">
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-sky-500 text-slate-950 text-xs flex items-center justify-center font-black">1</span>
              Customer Contact & Delivery
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label class="text-xs font-semibold text-slate-300">Full Name</label>
                <input type="text" name="name" placeholder="Johnathan Miller" required class="w-full bg-slate-900 border border-white/10 rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-sky-400">
              </div>
              <div class="space-y-1.5">
                <label class="text-xs font-semibold text-slate-300">Email Address</label>
                <input type="email" name="email" placeholder="john@cybertech.org" required class="w-full bg-slate-900 border border-white/10 rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-sky-400">
              </div>
            </div>

            <div class="space-y-1.5">
              <label class="text-xs font-semibold text-slate-300">Street Address</label>
              <input type="text" name="address" placeholder="42 Titanium Boulevard, Suite 800" required class="w-full bg-slate-900 border border-white/10 rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-sky-400">
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label class="text-xs font-semibold text-slate-300">City / District</label>
                <input type="text" name="city" placeholder="San Francisco, CA" required class="w-full bg-slate-900 border border-white/10 rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-sky-400">
              </div>
              <div class="space-y-1.5">
                <label class="text-xs font-semibold text-slate-300">Postal / ZIP Code</label>
                <input type="text" name="zip" placeholder="94107" required class="w-full bg-slate-900 border border-white/10 rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-sky-400">
              </div>
            </div>
          </div>

          <!-- Step 2: Payment Method -->
          <div class="glass-panel p-6 rounded-2xl space-y-4">
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-indigo-500 text-white text-xs flex items-center justify-center font-black">2</span>
              Payment Method
            </h2>

            <div class="grid grid-cols-3 gap-3">
              <label class="glass-card p-3 rounded-xl border border-sky-500/40 bg-sky-500/10 cursor-pointer flex flex-col items-center text-center gap-1">
                <input type="radio" name="payment_method" value="Credit Card" checked class="accent-sky-400">
                <span class="text-xs font-bold text-white">Credit Card</span>
                <span class="text-[10px] text-slate-400">Visa / MC / Amex</span>
              </label>

              <label class="glass-card p-3 rounded-xl border border-white/10 cursor-pointer flex flex-col items-center text-center gap-1 hover:border-white/20">
                <input type="radio" name="payment_method" value="Apple Pay" class="accent-sky-400">
                <span class="text-xs font-bold text-white">Apple Pay</span>
                <span class="text-[10px] text-slate-400">1-Touch Pay</span>
              </label>

              <label class="glass-card p-3 rounded-xl border border-white/10 cursor-pointer flex flex-col items-center text-center gap-1 hover:border-white/20">
                <input type="radio" name="payment_method" value="Crypto (USDC)" class="accent-sky-400">
                <span class="text-xs font-bold text-white">Crypto</span>
                <span class="text-[10px] text-slate-400">USDC / Solana</span>
              </label>
            </div>

            <!-- Demo Card Fields -->
            <div class="p-4 rounded-xl bg-slate-900/80 border border-white/5 space-y-3 pt-4">
              <div class="space-y-1">
                <label class="text-[10px] uppercase font-bold text-slate-400">Card Number (Demo sandbox)</label>
                <input type="text" placeholder="4242 •••• •••• 4242" value="4242 •••• •••• 4242" readonly class="w-full bg-slate-950 border border-white/10 rounded-lg px-3 py-2 text-xs font-mono text-slate-300">
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div class="space-y-1">
                  <label class="text-[10px] uppercase font-bold text-slate-400">Expiry</label>
                  <input type="text" value="12 / 28" readonly class="w-full bg-slate-950 border border-white/10 rounded-lg px-3 py-2 text-xs font-mono text-slate-300">
                </div>
                <div class="space-y-1">
                  <label class="text-[10px] uppercase font-bold text-slate-400">CVV</label>
                  <input type="text" value="888" readonly class="w-full bg-slate-950 border border-white/10 rounded-lg px-3 py-2 text-xs font-mono text-slate-300">
                </div>
              </div>
            </div>

          </div>

          <!-- Submit Order Button -->
          <button type="submit" class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-sky-500 to-indigo-600 hover:from-sky-400 hover:to-indigo-500 text-white font-black text-base shadow-2xl shadow-sky-500/30 flex items-center justify-center gap-2 cursor-pointer transition">
            <span>Place Order (${{ total }})</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </button>

        </form>
      </div>

      <!-- Right Summary Panel -->
      <div class="lg:col-span-5 space-y-4">
        <div class="glass-panel p-6 rounded-2xl space-y-4">
          <h3 class="text-sm font-bold text-white uppercase tracking-wider pb-3 border-b border-white/10">Items in Order ({{ cart_items.len() }})</h3>
          
          <div class="space-y-3 max-h-72 overflow-y-auto pr-1">
            {% for item in cart_items %}
              <div class="flex items-center justify-between gap-3 text-xs">
                <div class="flex items-center gap-3">
                  <img src="{{ item.image_url }}" alt="{{ item.name }}" class="w-12 h-12 rounded-lg object-cover bg-slate-900 shrink-0">
                  <div>
                    <h4 class="font-bold text-white truncate max-w-[180px]">{{ item.name }}</h4>
                    <span class="text-slate-400">Qty: {{ item.quantity }} × ${{ item.price }}</span>
                  </div>
                </div>
                <span class="font-mono font-bold text-white">${{ item.line_total }}</span>
              </div>
            {% endfor %}
          </div>

          <!-- Totals -->
          <div class="pt-4 border-t border-white/10 space-y-2 text-xs">
            <div class="flex justify-between text-slate-400">
              <span>Subtotal</span>
              <span class="font-mono text-white">${{ subtotal }}</span>
            </div>
            {% if discount_amount > 0 %}
              <div class="flex justify-between text-emerald-400 font-medium">
                <span>Discount Applied</span>
                <span class="font-mono">-${{ discount_amount }}</span>
              </div>
            {% endif %}
            <div class="flex justify-between text-slate-400">
              <span>Express Delivery</span>
              <span class="font-mono text-white">{% if shipping_cost == 0 %}FREE{% else %}${{ shipping_cost }}{% endif %}</span>
            </div>
            <div class="pt-3 border-t border-white/10 flex justify-between text-base font-bold text-white">
              <span>Total Due</span>
              <span class="font-mono text-sky-400 text-xl">${{ total }}</span>
            </div>
          </div>

        </div>
      </div>

    </div>

  </main>

</body>
</html>
