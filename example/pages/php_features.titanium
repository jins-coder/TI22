---
// =========================================================================
// Titanium (Ti22) — Modern PHP 8.1 - 8.5 Ergonomics Showcase
// =========================================================================

// 1. [PHP 8.3] json_validate & JSON Decode
let raw_payload = "{\"plan\":\"enterprise\",\"seats\":25,\"active\":true}";
let is_valid_json = json_validate(raw_payload);
let decoded_data = json_decode(raw_payload);

// 2. [PHP 8.2] Sensitive Parameter Redaction & Masking
let user_profile = #{
    name: "Ada Lovelace",
    email: "ada.lovelace@analytical.org",
    api_key: "sk_live_93847291827401928374",
    credit_card: "4532-8932-1092-8821",
    role: "Admin"
};
let masked_email = mask(user_profile.email, 4);
let masked_card = mask(user_profile.credit_card, 4);
let safe_profile = redact(user_profile, ["api_key", "credit_card"]);

// 3. [PHP 8.4] Modern Array Primitives: array_pluck, array_chunk, array_group_by
let products = [
    #{ id: 1, name: "Titanium Core", category: "Engine", price: 199 },
    #{ id: 2, name: "Titanium Studio", category: "Tooling", price: 299 },
    #{ id: 3, name: "Titanium Edge", category: "Cloud", price: 499 },
    #{ id: 4, name: "Titanium Shield", category: "Security", price: 149 },
    #{ id: 5, name: "Titanium Stream", category: "Engine", price: 249 }
];

let product_names = array_pluck(products, "name");
let product_chunks = array_chunk(products, 2);
let products_by_category = array_group_by(products, "category");

// 4. [PHP 8.1 - 8.4] String & Math Primitives
let sample_slug = str_slug("Modern PHP 8.5 Features In Native Titanium!");
let check_contains = str_contains("Hypertext Preprocessor", "Preprocessor");
let clamped_val = clamp(150, 0, 100);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PHP 8.1 - 8.5 Modern Ergonomics in Titanium</title>
  <link rel="stylesheet" href="/app.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap">
</head>
<body>
  <div class="container">
    <header class="hero">
      <div class="badge">🐘 PHP 8.1 - 8.5 INSPIRED ERGONOMICS</div>
      <h1>Modern PHP Primitives in Titanium</h1>
      <div style="margin-top: 15px; display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
        <a href="/" class="btn" style="font-size: 0.85rem; padding: 6px 14px; text-decoration: none; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);">🏠 Dashboard</a>
        <a href="/spa_demo" class="btn" style="font-size: 0.85rem; padding: 6px 14px; text-decoration: none; background: rgba(56, 189, 248, 0.15); border: 1px solid rgba(56, 189, 248, 0.3); color: #38bdf8;">⚡ Turbo SPA Demo</a>
        <a href="/nextgen" class="btn" style="font-size: 0.85rem; padding: 6px 14px; text-decoration: none; background: rgba(56, 189, 248, 0.15); border: 1px solid rgba(56, 189, 248, 0.3); color: #38bdf8;">🚀 Next-Gen Omniverse</a>
        <a href="/php_features" class="btn btn-primary" style="font-size: 0.85rem; padding: 6px 14px; text-decoration: none;">🐘 PHP Primitives</a>
        <a href="/__titanium_studio" class="btn" style="font-size: 0.85rem; padding: 6px 14px; text-decoration: none; background: rgba(168, 85, 247, 0.15); border: 1px solid rgba(168, 85, 247, 0.3); color: #c084fc;">🛠️ Web Studio</a>
      </div>
    </header>

    <div class="grid">
      <!-- 1. JSON Validate (PHP 8.3) -->
      <div class="card">
        <h2>⚡ 1. [PHP 8.3] json_validate()</h2>
        <p class="card-desc">Zero-allocation JSON validation directly in the runtime.</p>
        <div style="background: rgba(0,0,0,0.3); padding: 12px; border-radius: 8px; font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; margin-top: 10px;">
          <div><strong>Input:</strong> <code>{{ raw_payload }}</code></div>
          <div style="margin-top: 6px;"><strong>json_validate():</strong> <span class="role-badge" style="background: rgba(16, 185, 129, 0.2); color: #34d399;">{{ is_valid_json }}</span></div>
          <div style="margin-top: 6px;"><strong>Decoded Plan:</strong> {{ decoded_data.plan }} ({{ decoded_data.seats }} seats)</div>
        </div>
      </div>

      <!-- 2. Sensitive Parameter Redaction & Masking (PHP 8.2) -->
      <div class="card">
        <h2>🛡️ 2. [PHP 8.2] Sensitive Redaction & Masking</h2>
        <p class="card-desc">Built-in masking and redaction for security-first applications.</p>
        <div style="background: rgba(0,0,0,0.3); padding: 12px; border-radius: 8px; font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; margin-top: 10px;">
          <div><strong>Masked Email:</strong> <code>{{ masked_email }}</code></div>
          <div style="margin-top: 6px;"><strong>Masked Card:</strong> <code>{{ masked_card }}</code></div>
          <div style="margin-top: 6px;"><strong>Redacted API Key:</strong> <code>{{ safe_profile.api_key }}</code></div>
        </div>
      </div>

      <!-- 3. Array Primitives (PHP 8.4) -->
      <div class="card">
        <h2>🧩 3. [PHP 8.4] array_pluck & array_chunk</h2>
        <p class="card-desc">Functional collection manipulation without boilerplate.</p>
        <div style="background: rgba(0,0,0,0.3); padding: 12px; border-radius: 8px; font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; margin-top: 10px;">
          <div><strong>Plucked Names:</strong></div>
          <ul style="margin: 6px 0 10px 20px; color: #a1a1aa;">
            {% for name in product_names %}
              <li>{{ name }}</li>
            {% endfor %}
          </ul>
          <div><strong>Chunk Count (size=2):</strong> {{ product_chunks.len() }} chunks created</div>
        </div>
      </div>

      <!-- 4. String & Math Primitives (PHP 8.1 - 8.5) -->
      <div class="card">
        <h2>💎 4. String & Math Helpers</h2>
        <p class="card-desc">High performance slugification, containment checks & clamping.</p>
        <div style="background: rgba(0,0,0,0.3); padding: 12px; border-radius: 8px; font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; margin-top: 10px;">
          <div><strong>Slug:</strong> <code>{{ sample_slug }}</code></div>
          <div style="margin-top: 6px;"><strong>Contains 'Preprocessor':</strong> {{ check_contains }}</div>
          <div style="margin-top: 6px;"><strong>clamp(150, 0, 100):</strong> <code>{{ clamped_val }}</code></div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
