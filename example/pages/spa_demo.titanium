---
// =========================================================================
// Titanium (Ti22) — Turbo SPA (Single Page Application) Showcase
// =========================================================================

// 1. Ensure SQLite tasks table exists
db_exec("CREATE TABLE IF NOT EXISTS spa_tasks (id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT NOT NULL, priority TEXT DEFAULT 'normal', completed INTEGER DEFAULT 0, created_at DATETIME DEFAULT CURRENT_TIMESTAMP);");

// 2. Handle POST Actions (Add task, Toggle, Delete) with Zero-Reload Turbo SPA
if req.method == "POST" {
  let action = body.action;
  let task_id = body.id;

  if action == "add" && body.title != () && body.title != "" {
    let priority = if body.priority != () && body.priority != "" { body.priority } else { "normal" };
    db_run("INSERT INTO spa_tasks (title, priority) VALUES (?, ?)", [body.title, priority]);
    session.flash("msg", "⚡ Task created instantly via Turbo SPA submission!");
  } else if action == "toggle" && task_id != () {
    db_run("UPDATE spa_tasks SET completed = CASE WHEN completed = 1 THEN 0 ELSE 1 END WHERE id = ?", [task_id]);
    session.flash("msg", "🔄 Task status updated without full page reload!");
  } else if action == "delete" && task_id != () {
    db_run("DELETE FROM spa_tasks WHERE id = ?", [task_id]);
    session.flash("msg", "🗑️ Task removed in microsecond transaction!");
  }

  return redirect("/spa_demo");
}

// 3. Query Database
let tasks = db_query("SELECT * FROM spa_tasks ORDER BY completed ASC, id DESC");
let total_tasks = tasks.len();
let completed_tasks = db_first("SELECT COUNT(*) as count FROM spa_tasks WHERE completed = 1");
let completed_count = if completed_tasks != () { completed_tasks.count } else { 0 };
let msg = session.flash("msg");
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Turbo SPA Showcase | Titanium (Ti22)</title>
  <link rel="stylesheet" href="/app.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap">
</head>
<body>
  <div class="container">
    <header class="hero">
      <div class="badge">⚡ ZERO-RELOAD TURBO SPA ENGINE</div>
      <h1>Turbo SPA in Action</h1>
      <p class="subtitle">HTML-over-the-Wire • Zero White Flash • Instant Soft-DOM Patching • Preserved Client State</p>
      
      <!-- Navigation bar demonstrating instant seamless SPA transitions -->
      <div style="margin-top: 20px; display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
        <a href="/" class="btn" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); text-decoration: none; padding: 6px 14px; font-size: 0.85rem;">🏠 Home</a>
        <a href="/spa_demo" class="btn btn-primary" style="text-decoration: none; padding: 6px 14px; font-size: 0.85rem;">⚡ SPA Demo (Active)</a>
        <a href="/nextgen" class="btn" style="background: rgba(56, 189, 248, 0.15); border: 1px solid rgba(56, 189, 248, 0.3); color: #38bdf8; text-decoration: none; padding: 6px 14px; font-size: 0.85rem;">🚀 Next-Gen Omniverse</a>
        <a href="/php_features" class="btn" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); text-decoration: none; padding: 6px 14px; font-size: 0.85rem;">🐘 PHP Primitives</a>
        <a href="/__titanium_studio" class="btn" style="background: rgba(168, 85, 247, 0.15); border: 1px solid rgba(168, 85, 247, 0.3); color: #c084fc; text-decoration: none; padding: 6px 14px; font-size: 0.85rem;">🛠️ Web Studio</a>
      </div>
    </header>

    {% if msg %}
      <div class="alert alert-success">{{ msg }}</div>
    {% endif %}

    <!-- Live Client Timer & Persistent State Banner -->
    <div class="card" style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; background: linear-gradient(135deg, rgba(56, 189, 248, 0.08) 0%, rgba(129, 140, 248, 0.08) 100%);">
      <div>
        <div style="font-size: 12px; font-weight: 700; color: #38bdf8; text-transform: uppercase;">Client Session Active</div>
        <div style="font-size: 15px; margin-top: 4px;">
          ⏱️ Page Session Elapsed: <strong id="session-timer" style="color: #38bdf8; font-family: 'JetBrains Mono', monospace;">0s</strong>
        </div>
      </div>
      <div style="text-align: right;">
        <div style="font-size: 12px; color: #94a3b8;">SPA Telemetry</div>
        <div style="font-size: 13px; font-weight: 700; color: #34d399;">● 0ms Page Flashes</div>
      </div>
    </div>

    <div class="grid">
      <!-- Add Task Card -->
      <div class="card">
        <h2>➕ Add Task (Turbo SPA POST)</h2>
        <p class="card-desc">Submits form asynchronously via fetch, performs SQLite write, and re-renders smoothly.</p>

        <form method="POST" action="/spa_demo" class="form">
          <input type="hidden" name="action" value="add">
          
          <div class="form-group">
            <label>Task Title</label>
            <input type="text" name="title" placeholder="e.g. Test zero-reload form submit" required>
          </div>

          <div class="form-group">
            <label>Priority</label>
            <select name="priority">
              <option value="high">🔴 High Priority</option>
              <option value="normal" selected>🟡 Normal Priority</option>
              <option value="low">🟢 Low Priority</option>
            </select>
          </div>

          <button type="submit" class="btn btn-primary">⚡ Save Task in SQLite (No Reload)</button>
        </form>
      </div>

      <!-- Task List Card -->
      <div class="card">
        <div class="card-header-flex">
          <h2>📋 Realtime Tasks ({{ total_tasks }})</h2>
          <span class="role-tag" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">{{ completed_count }} / {{ total_tasks }} Done</span>
        </div>
        <p class="card-desc">Clicking buttons toggles or deletes rows with instant micro-progress feedback.</p>

        {% if total_tasks == 0 %}
          <div class="empty-state">
            <p>No tasks yet! Add one on the left to see the instant Turbo SPA interaction.</p>
          </div>
        {% else %}
          <div class="user-list">
            {% for t in tasks %}
              <div class="user-item" style="opacity: {% if t.completed == 1 %}0.6{% else %}1.0{% endif %};">
                <div style="display: flex; align-items: center; gap: 12px;">
                  <form method="POST" action="/spa_demo" style="margin: 0;">
                    <input type="hidden" name="action" value="toggle">
                    <input type="hidden" name="id" value="{{ t.id }}">
                    <button type="submit" style="background: {% if t.completed == 1 %}#10b981{% else %}rgba(255,255,255,0.1){% endif %}; border: 1px solid rgba(255,255,255,0.2); width: 22px; height: 22px; border-radius: 6px; cursor: pointer; color: #fff; font-size: 11px; display: grid; place-content: center;">
                      {% if t.completed == 1 %}✓{% endif %}
                    </button>
                  </form>

                  <div class="user-info">
                    <span class="user-name" style="{% if t.completed == 1 %}text-decoration: line-through; color: #94a3b8;{% endif %}">
                      {{ t.title }}
                    </span>
                    <span class="user-email">{{ t.created_at }}</span>
                  </div>
                </div>

                <div class="user-meta">
                  <span class="role-tag" style="font-size: 10px;">{{ t.priority }}</span>
                  <form method="POST" action="/spa_demo" style="display: inline; margin: 0;">
                    <input type="hidden" name="action" value="delete">
                    <input type="hidden" name="id" value="{{ t.id }}">
                    <button type="submit" class="btn-delete" title="Delete Task">✕</button>
                  </form>
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>

    <!-- Comparison: SPA vs Native Reload Section -->
    <div class="card" style="margin-top: 24px;">
      <h3 style="margin-top: 0; margin-bottom: 8px;">🔍 SPA vs Traditional Multi-Page Comparison</h3>
      <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 16px;">
        Notice how the timer above keeps counting smoothly without resetting when you click links or submit tasks!
      </p>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a href="/spa_demo" class="btn btn-primary" style="flex: 1; text-align: center; text-decoration: none; padding: 10px;">
          ⚡ Turbo SPA Navigation (Soft-DOM)
        </a>
        <a href="/spa_demo" data-native class="btn" style="flex: 1; text-align: center; text-decoration: none; padding: 10px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);">
          🔄 Force Full Page Reload (<code style="color: #f43f5e;">data-native</code>)
        </a>
      </div>
    </div>

    <footer class="footer">
      <p>Powered by <strong>Titanium (Ti22)</strong> • Native Turbo SPA Engine</p>
    </footer>
  </div>

  <script>
    // Live continuous client timer proving state survives soft-DOM SPA page transitions
    if (!window.__spa_start_time) {
      window.__spa_start_time = Date.now();
    }
    function updateTimer() {
      const el = document.getElementById('session-timer');
      if (el) {
        const secs = Math.floor((Date.now() - window.__spa_start_time) / 1000);
        el.textContent = secs + 's';
      }
      setTimeout(updateTimer, 500);
    }
    updateTimer();
  </script>
</body>
</html>
