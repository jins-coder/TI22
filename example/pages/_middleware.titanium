// =========================================================================
// Titanium (Ti22) E-Commerce Middleware & Database Auto-Bootstrapper
// =========================================================================

// 1. Ensure Schema
db_exec("CREATE TABLE IF NOT EXISTS products (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, slug TEXT NOT NULL UNIQUE, category TEXT NOT NULL, price REAL NOT NULL, compare_at_price REAL DEFAULT 0, stock INTEGER DEFAULT 10, rating REAL DEFAULT 4.8, reviews_count INTEGER DEFAULT 24, image_url TEXT NOT NULL, badge TEXT DEFAULT '', description TEXT NOT NULL, is_featured INTEGER DEFAULT 0, created_at DATETIME DEFAULT CURRENT_TIMESTAMP);");

db_exec("CREATE TABLE IF NOT EXISTS cart_items (id INTEGER PRIMARY KEY AUTOINCREMENT, session_id TEXT NOT NULL, product_id INTEGER NOT NULL, quantity INTEGER DEFAULT 1, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, UNIQUE(session_id, product_id));");

db_exec("CREATE TABLE IF NOT EXISTS orders (id INTEGER PRIMARY KEY AUTOINCREMENT, order_number TEXT NOT NULL UNIQUE, customer_name TEXT NOT NULL, customer_email TEXT NOT NULL, customer_address TEXT NOT NULL, customer_city TEXT NOT NULL, subtotal REAL NOT NULL, discount REAL DEFAULT 0, shipping REAL DEFAULT 0, total REAL NOT NULL, status TEXT DEFAULT 'Processing', payment_method TEXT DEFAULT 'Credit Card', created_at DATETIME DEFAULT CURRENT_TIMESTAMP);");

db_exec("CREATE TABLE IF NOT EXISTS order_items (id INTEGER PRIMARY KEY AUTOINCREMENT, order_id INTEGER NOT NULL, product_id INTEGER NOT NULL, product_name TEXT NOT NULL, price REAL NOT NULL, quantity INTEGER NOT NULL, image_url TEXT NOT NULL);");

db_exec("CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, email TEXT NOT NULL UNIQUE, password_hash TEXT NOT NULL, role TEXT DEFAULT 'customer', created_at DATETIME DEFAULT CURRENT_TIMESTAMP);");

try {
  db_exec("ALTER TABLE users ADD COLUMN password_hash TEXT DEFAULT '';");
} catch(e) {}

try {
  db_exec("ALTER TABLE users ADD COLUMN role TEXT DEFAULT 'customer';");
} catch(e) {}

// Seed / update demo users
let admin_hash = crypto_hash("admin123");
let admin_user = db_first("SELECT id FROM users WHERE email = 'admin@titanium.io'");
if admin_user == () {
  db_run("INSERT INTO users (name, email, password_hash, role) VALUES (?, ?, ?, ?)", ["Commander Admin", "admin@titanium.io", admin_hash, "admin"]);
} else {
  db_run("UPDATE users SET password_hash = ?, role = 'admin' WHERE email = 'admin@titanium.io'", [admin_hash]);
}

let user_hash = crypto_hash("password123");
let cust_user = db_first("SELECT id FROM users WHERE email = 'user@titanium.io'");
if cust_user == () {
  db_run("INSERT INTO users (name, email, password_hash, role) VALUES (?, ?, ?, ?)", ["Valued Customer", "user@titanium.io", user_hash, "customer"]);
} else {
  db_run("UPDATE users SET password_hash = ?, role = 'customer' WHERE email = 'user@titanium.io'", [user_hash]);
}

// 2. Seed initial catalog if empty
let product_count_res = db_first("SELECT COUNT(*) as count FROM products");
let product_count = if product_count_res != () { product_count_res.count } else { 0 };

if product_count == 0 {
  db_run("INSERT INTO products (name, slug, category, price, compare_at_price, stock, rating, reviews_count, image_url, badge, description, is_featured) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
    ["Titanium Apex Mechanical Keyboard", "titanium-apex-keyboard", "Peripherals", 349.00, 399.00, 18, 4.9, 142, "https://images.unsplash.com/photo-1587829741301-dc798b83add3?auto=format&fit=crop&w=800&q=80", "Bestseller", "CNC-machined Grade 5 titanium chassis with hot-swappable tactile switches, gasket mount acoustic dampening, and programmable RGB telemetry.", 1]);

  db_run("INSERT INTO products (name, slug, category, price, compare_at_price, stock, rating, reviews_count, image_url, badge, description, is_featured) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
    ["Ti-22 Chrono Smartwatch", "ti-22-chrono-smartwatch", "Wearables", 499.00, 580.00, 12, 4.8, 89, "https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=800&q=80", "New Release", "Aerospace titanium casing, sapphire crystal OLED display, 14-day battery life, and biometric neural sync sensors.", 1]);

  db_run("INSERT INTO products (name, slug, category, price, compare_at_price, stock, rating, reviews_count, image_url, badge, description, is_featured) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
    ["CyberDeck Alpha Mobile Workstation", "cyberdeck-alpha-workstation", "Hardware", 1299.00, 1450.00, 7, 5.0, 37, "https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=800&q=80", "Featured", "Ultra-compact terminal PC with mechanical ortholinear keyboard, 7-inch sunlight-readable display, and dual NVMe slots.", 1]);

  db_run("INSERT INTO products (name, slug, category, price, compare_at_price, stock, rating, reviews_count, image_url, badge, description, is_featured) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
    ["Neural Wireless Studio Headphones", "neural-studio-headphones", "Audio", 279.00, 320.00, 25, 4.7, 98, "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=800&q=80", "Top Rated", "40mm planar magnetic drivers encased in brushed titanium earcups with adaptive hybrid active noise cancellation.", 1]);

  db_run("INSERT INTO products (name, slug, category, price, compare_at_price, stock, rating, reviews_count, image_url, badge, description, is_featured) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
    ["Titanium Minimalist EDC Cardholder", "titanium-minimalist-wallet", "Gear", 89.00, 110.00, 45, 4.9, 312, "https://images.unsplash.com/photo-1627123424574-724758594e93?auto=format&fit=crop&w=800&q=80", "", "RFID-blocking dual-plate titanium cardholder with ceramic bead-blasted finish and integrated money clip.", 0]);

  db_run("INSERT INTO products (name, slug, category, price, compare_at_price, stock, rating, reviews_count, image_url, badge, description, is_featured) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
    ["Quantum Precision Studio Microphone", "quantum-studio-microphone", "Audio", 219.00, 260.00, 14, 4.8, 64, "https://images.unsplash.com/photo-1590602847861-f357a9332bbc?auto=format&fit=crop&w=800&q=80", "", "Broadcasting condenser mic with pure titanium mesh capsule and zero-latency internal DSP preamplifier.", 0]);

  // Seed sample initial orders
  db_run("INSERT INTO orders (order_number, customer_name, customer_email, customer_address, customer_city, subtotal, discount, shipping, total, status, payment_method) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
    ["TI-98241", "Alex Mercer", "alex.mercer@cybernet.io", "742 Evergreen Terrace", "Neo Seattle", 848.00, 0.0, 0.0, 848.00, "Delivered", "Apple Pay"]);

  db_run("INSERT INTO orders (order_number, customer_name, customer_email, customer_address, customer_city, subtotal, discount, shipping, total, status, payment_method) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
    ["TI-98242", "Elena Rostova", "elena.r@quantum.tech", "101 Cyber Way, Suite 400", "San Francisco", 349.00, 69.80, 0.0, 279.20, "Shipped", "Credit Card"]);

  let o1 = db_first("SELECT id FROM orders WHERE order_number = 'TI-98241'");
  if o1 != () {
    db_run("INSERT INTO order_items (order_id, product_id, product_name, price, quantity, image_url) VALUES (?, 1, 'Titanium Apex Mechanical Keyboard', 349.00, 1, 'https://images.unsplash.com/photo-1587829741301-dc798b83add3?auto=format&fit=crop&w=800&q=80')", [o1.id]);
    db_run("INSERT INTO order_items (order_id, product_id, product_name, price, quantity, image_url) VALUES (?, 2, 'Ti-22 Chrono Smartwatch', 499.00, 1, 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=800&q=80')", [o1.id]);
  }
}
