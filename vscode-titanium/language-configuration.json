{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["<", ">"],
    ["{%", "%}"],
    ["{{", "}}"],
    ["{#", "#}"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] },
    { "open": "<!--", "close": "-->", "notIn": ["comment", "string"] },
    { "open": "{%", "close": "%}" },
    { "open": "{{", "close": "}}" },
    { "open": "{#", "close": "#}" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["<", ">"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"],
    ["{%", "%}"],
    ["{{", "}}"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*<!--\\s*#region|^\\s*---|^\\s*{%\\s*(if|for|block)",
      "end": "^\\s*<!--\\s*#endregion|^\\s*---|^\\s*{%\\s*(endif|endfor|endblock)"
    }
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)"
}
